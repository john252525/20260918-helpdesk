[Unit]
Description=Helpdesk API (WhatsApp / VK / Email, API-first)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/20260918-helpdesk
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/20260918-helpdesk/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8091
Restart=always
RestartSec=3
StandardOutput=append:/var/log/helpdesk.log
StandardError=append:/var/log/helpdesk.log

[Install]
WantedBy=multi-user.target
