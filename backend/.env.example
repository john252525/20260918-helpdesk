# ---- Core ----
APP_NAME=Helpdesk
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./data/helpdesk.db

# ---- Bootstrap admin ----
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# задайте свой пароль: без него bootstrap-админ не создастся
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# ---- CORS (frontend origin, standalone client) ----
CORS_ORIGINS=*

# ---- WhatsApp (numbered) provider ----
# Incoming: POST {PUBLIC_BASE_URL}/api/v1/webhooks/whatsapp/{channel_id}
# Outgoing: POST {WHATSAPP_BASE_URL}/sendMessage  with header Authorization: Bearer {WHATSAPP_TOKEN}
WHATSAPP_BASE_URL=
WHATSAPP_TOKEN=
WHATSAPP_SEND_PATH=/sendMessage

# ---- VK group ----
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_CONFIRMATION_CODE=
VK_SECRET=
VK_API_VERSION=5.199

# ---- VK OAuth (Authorization Code Flow) ----
VK_APP_ID=your_app_id_here
VK_CLIENT_SECRET=your_protected_key_here
VK_OAUTH_FRONTEND_URL=/app/
VK_SERVICE_TOKEN=your_service_key_here

# ---- Email ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_POLL_SECONDS=60

# Public URL used in webhook URLs shown to providers
# Public origin of this service. Webhook URLs and the VK OAuth
# redirect are derived from it, so dev -> prod is a one-line change.
PUBLIC_BASE_URL=https://your-domain.example
